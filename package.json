{
  "name": "dsh-sweeper",
  "version": "1.4.0",
  "type": "module",
  "description": "清理对话留下的临时文件与垃圾，释放磁盘空间；只报告，清理进回收站可恢复 (cleanup junk files conversations leave on disk, free up space)",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cleanup",
    "garbage-collector",
    "disk-space",
    "audit",
    "junk-files",
    "temporary-files",
    "cache",
    "trash",
    "free-up-space",
    "清理内存",
    "清理对话",
    "清理垃圾",
    "释放空间",
    "回收站"
  ],
  "license": "MIT",
  "author": "Dushiqi1987",
  "homepage": "https://github.com/Dushiqi1987/dsh-sweeper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dushiqi1987/dsh-sweeper.git"
  },
  "bugs": {
    "url": "https://github.com/Dushiqi1987/dsh-sweeper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "icon.svg",
    "lib",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "guards": "node scripts/preflight.mjs",
    "contract": "node test/contract.mjs",
    "messages": "node test/messages.mjs",
    "listing": "node test/market-listing.mjs",
    "shots": "node test/screenshots.mjs"
  }
}
